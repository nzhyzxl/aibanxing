# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 阿里云 OSS
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=aibanxing-images
OSS_CDN_DOMAIN=https://aibanxing-images.oss-cn-hangzhou.aliyuncs.com

# 微信公众号
NEXT_PUBLIC_WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret

# 后台管理（MVP简单认证密码）
ADMIN_SECRET=change_this_to_a_strong_password

# Resend 邮件（海外询价通知）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AiBanXing <noreply@aibanxing.top>

# 自动翻译（产品中文→英文）
# TRANSLATION_PROVIDER 可选 minimax（默认）或 deepseek
TRANSLATION_PROVIDER=minimax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-M2.7
# 如切换为 DeepSeek，填写以下两项（模型可选 deepseek-v4-flash / deepseek-v4-pro）
# TRANSLATION_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-v4-flash
